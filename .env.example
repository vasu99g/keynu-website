# =============================================================================
# Keynu website environment variables
# =============================================================================
# Copy this file to `.env.local` and fill values. NEVER commit `.env.local`.
# All services are stubbed locally during early development — values below are
# only required when switching from stubs to live services.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Content source ---------------------------------------------------------
# Switch between "local" (stubbed TypeScript content modules) and "sanity"
# (live Sanity CMS). Default during prototyping: local.
CONTENT_SOURCE="local"

# --- Sanity (only needed when CONTENT_SOURCE="sanity") ----------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_READ_TOKEN=""

# --- Email (Resend) ---------------------------------------------------------
# When unset, emails are written to .local-stubs/emails/ for inspection.
RESEND_API_KEY=""
EMAIL_FROM="Keynu <bookings@keynu.in>"
EMAIL_CLINIC_INBOX="contact@keynu.com"

# --- WhatsApp ---------------------------------------------------------------
# International format (no +, no spaces) — used by the floating CTA + booking
# notifications.
NEXT_PUBLIC_WHATSAPP_NUMBER="919311041404"

# --- Analytics (loaded only when set in production) -------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
